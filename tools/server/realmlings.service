# The Realmlings dedicated server as a system service (docs/SERVER.md).
# Copy to /etc/systemd/system/realmlings.service, then: sudo systemctl daemon-reload && sudo systemctl start realmlings
#
# Restart=on-failure: a crash brings the server back by itself, and the lobby offers the interrupted game again.
# 0.19.3: every finished game (no player left in it, or no player's nation standing) also ends with exit code 75,
# "start me again", so a fresh empty lobby is always ready (Host online looks for one).

[Unit]
Description=Realmlings dedicated server
After=network-online.target
Wants=network-online.target

[Service]
User=realmlings
WorkingDirectory=/home/realmlings/server
ExecStart=/home/realmlings/server/Realmlings.x86_64 --headless -- --server --port=24565 --saves=/home/realmlings/saves
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
